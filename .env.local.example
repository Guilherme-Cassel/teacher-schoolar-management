# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# Settings -> API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A connection string NAO e necessaria para rodar o app.
# Use apenas se for aplicar migrations pela CLI, e nunca faca commit dela.
# SUPABASE_DB_URL=postgresql://postgres:[SENHA]@db.xxxx.supabase.co:5432/postgres
